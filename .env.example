# demo = turmas fictícias, nada vai para planilha | sheets = Google Sheets real (nunca cai para demo se falhar)
DATA_MODE=demo

# Obrigatório em produção: string aleatória longa (openssl rand -base64 32). Assina os convites.
INVITE_SECRET=

# --- Google Sheets (somente DATA_MODE=sheets) ---
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# chave privada do JSON da service account; mantenha as quebras como \n dentro de aspas
GOOGLE_PRIVATE_KEY=

# --- Opções do formulário ---
ALLOW_OTHER_BAIRRO=true
ALLOW_INTEREST_ANY_SLOT=true
INTEREST_TIMES=08:00,10:00,14:00,18:00,19:00,20:00
LEAD_ORIGEM=landing-page

NEXT_PUBLIC_SITE_URL=http://localhost:3000
# WhatsApp comercial do professor (opcional, só dígitos com 55)
NEXT_PUBLIC_WHATSAPP=

# --- Rota /inscricao (aula gratuita) ---
# PENDENTE: destino das inscrições (endpoint que aceita POST JSON). Sem isso a API responde 503 e nada é salvo.
INSCRICAO_WEBHOOK_URL=
INSCRICAO_WEBHOOK_TOKEN=
# true = mostra "inscrições encerradas" e bloqueia a API
NEXT_PUBLIC_INSCRICAO_ENCERRADA=
